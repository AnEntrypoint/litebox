#!/usr/bin/with-contenv bash
export DISPLAY=:1
sleep 100
mkdir -p /tmp/pub
SP=$(pgrep -x xfce4-session | head -1)
DB=$(tr '\0' '\n' < /proc/$SP/environ 2>/dev/null | grep '^DBUS_SESSION_BUS_ADDRESS=' | cut -d= -f2-)
echo "dbus=$DB sp=$SP" > /tmp/pub/apps.log
run_app() {
  name=$1; shift
  echo "== $name: $*" >> /tmp/pub/apps.log
  s6-setuidgid abc env DISPLAY=:1 HOME=/config XDG_RUNTIME_DIR=/tmp/xdg DBUS_SESSION_BUS_ADDRESS="$DB" "$@" > /tmp/pub/app-$name.out 2>&1 &
  pid=$!
  sleep 30
  if kill -0 $pid 2>/dev/null; then echo "$name alive" >> /tmp/pub/apps.log; else wait $pid; echo "$name EXITED rc=$?" >> /tmp/pub/apps.log; fi
  xwd -root -silent > /tmp/pub/app.tmp 2>/dev/null && mv /tmp/pub/app.tmp /tmp/pub/app-$name.xwd
  pkill -TERM -P $pid 2>/dev/null; kill $pid 2>/dev/null; sleep 3
}
run_app webbrowser exo-open --launch WebBrowser
run_app xdgopen xdg-open http://127.0.0.1:3000/
run_app mousepad mousepad /tmp/pub/apps.log
run_app thunar thunar /config
run_app term xfce4-terminal -e "sh -c 'ls / | head -3; sleep 20'"
run_app whisker xfce4-popup-whiskermenu
run_app appfinder xfce4-appfinder
run_app settings xfce4-settings-manager
echo ALLDONE >> /tmp/pub/apps.log
